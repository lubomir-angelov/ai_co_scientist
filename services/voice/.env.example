# Voice service configuration. compose.yaml supplies these defaults; Python never invents one
# (an unset or empty variable fails the service at startup, naming the variable).

# OCR service the paper script is prepared from (needs OCR running only for the prepare step).
VOICE_OCR_BASE_URL=http://ocr:8002
# Timeout for GET /ocr/documents/{doc_id}, seconds (> 0).
VOICE_OCR_TIMEOUT_SECONDS=60
# Kokoro voice id; must be a voice pack baked into the image (voices/<id>.pt). The first
# character selects the language/G2P (a = American English, b = British English).
VOICE_TTS_VOICE=af_heart
# Kokoro speed factor, 0.5 to 2.0.
VOICE_TTS_SPEED=1.0
# Concurrent streaming responses; more get HTTP 429.
VOICE_MAX_ACTIVE_STREAMS=2
# Concurrent transcription requests; more get HTTP 429.
VOICE_MAX_PENDING_TRANSCRIPTIONS=2
# Bounded render queue; a full queue returns HTTP 429.
VOICE_RENDER_QUEUE_MAX=16
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Host directory bind-mounted at /data (scripts + rendered MP3s).
VOICE_HOST_DATA_DIR=../../data/voice
