# LLM Configuration
LLM_MODEL=Qwen3.8-27B-UD-Q4_K_XL
LLM_API_KEY=local-llm
# Qwen thinking for the full stack (default off; standalone llm defaults to on)
LLM_REASONING=off

# Service URLs (internal docker network)
LLM_BASE_URL=http://llm-gateway:8000/v1
OCR_BASE_URL=http://ocr:8002
MEMORY_BASE_URL=http://memory:8005

# Memory service (Graphiti + FalkorDB)
# Model id Graphiti uses for entity/fact extraction; must be served by the llm service.
MEMORY_LLM_MODEL=Qwen3.8-27B-UD-Q4_K_XL
# Set to json_object if the LLM rejects json_schema response formats.
MEMORY_LLM_STRUCTURED_OUTPUT=json_schema
MEMORY_GRAPH_NAME=photonic_memory
# GGUF file in ./models/embeddings served by the embeddings service
EMBEDDING_MODEL_FILE=Qwen3-Embedding-0.6B-Q8_0.gguf
EMBEDDING_MODEL=Qwen3-Embedding-0.6B
EMBEDDING_DIM=1024

# GPU Configuration
CUDA_VISIBLE_DEVICES=0

# Logging
LOG_LEVEL=INFO
